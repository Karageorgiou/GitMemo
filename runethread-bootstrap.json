{
  "bootstrap_protocol": 1,
  "project": "Runethread",
  "canonical_repository": "runethread/core",
  "setup_instructions": "AI_SETUP.md",
  "template": {
    "repository": "runethread/memory-template",
    "default_memory_repository_name": "runethread-memory",
    "required_visibility": "private",
    "create_url": "https://github.com/new?owner=%40me&name=runethread-memory&visibility=private&template_owner=runethread&template_name=memory-template"
  },
  "discovery": {
    "repository_name_hint": "runethread-memory",
    "required_paths": [
      ".runethread/config.json",
      ".runethread/lock.json",
      "MEMORY_PROTOCOL.md",
      "memories",
      "projects"
    ]
  },
  "release": {
    "repository": "runethread/core",
    "strategy": "latest-stable-official-release",
    "template_is_release_pinned": true,
    "existing_repositories_upgrade_explicitly": true
  },
  "commands": {
    "store": "Runethread: store ...",
    "search": "Runethread: search ..."
  },
  "security": {
    "personal_data_allowed_in_canonical_repository": false,
    "personal_data_allowed_in_template_repository": false,
    "memory_repository_must_be_private_before_personal_writes": true,
    "request_credentials": false
  }
}
