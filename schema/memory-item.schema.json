{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistent Memory Item Sidecar",
  "description": "Schema for the machine-readable JSON sidecar paired with one atomic Markdown memory item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "type",
    "lifecycle",
    "summary",
    "projects",
    "topics",
    "tags",
    "aliases",
    "entities",
    "importance",
    "temporal",
    "provenance",
    "relationships",
    "content_path",
    "sensitivity"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"$ref": "#/$defs/uuid_v4"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "type": {"type": "string", "enum": ["fact", "preference", "decision", "state", "open_loop", "correction", "milestone", "reference"]},
    "lifecycle": {"type": "string", "enum": ["active", "superseded", "withdrawn"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "projects": {"type": "array", "uniqueItems": true, "maxItems": 20, "items": {"$ref": "#/$defs/slug"}},
    "topics": {"type": "array", "uniqueItems": true, "maxItems": 30, "items": {"$ref": "#/$defs/slug"}},
    "tags": {"type": "array", "uniqueItems": true, "maxItems": 50, "items": {"$ref": "#/$defs/slug"}},
    "aliases": {"type": "array", "uniqueItems": true, "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "entities": {"type": "array", "uniqueItems": true, "maxItems": 50, "items": {"$ref": "#/$defs/entity"}},
    "importance": {"type": "string", "enum": ["normal", "high", "critical"]},
    "temporal": {"$ref": "#/$defs/temporal"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "relationships": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/relationship"}},
    "content_path": {"type": "string", "pattern": "^memories(?:/[a-z0-9]+(?:-[a-z0-9]+)*)+/[a-z0-9]+(?:-[a-z0-9]+)*--[0-9a-f]{8}\\.md$"},
    "sensitivity": {"type": "string", "enum": ["routine", "private", "sensitive"]},
    "open_loop_status": {"type": "string", "enum": ["open", "blocked", "deferred", "resolved", "cancelled"]}
  },
  "allOf": [{"if": {"properties": {"type": {"const": "open_loop"}}, "required": ["type"]}, "then": {"required": ["open_loop_status"]}, "else": {"not": {"required": ["open_loop_status"]}}}],
  "$defs": {
    "uuid_v4": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 100},
    "entity": {"type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": {"kind": {"$ref": "#/$defs/slug"}, "name": {"type": "string", "minLength": 1, "maxLength": 200}}},
    "temporal": {"type": "object", "additionalProperties": false, "required": ["created_at", "updated_at", "effective_from", "effective_until"], "properties": {"created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "effective_from": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}]}, "effective_until": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}]}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["basis", "confidence", "explicit_memory_request", "sources"], "properties": {"basis": {"type": "string", "enum": ["user_stated", "project_verified", "external_verified", "derived", "inferred", "migrated"]}, "confidence": {"type": "string", "enum": ["high", "medium", "low"]}, "explicit_memory_request": {"type": "boolean"}, "sources": {"type": "array", "maxItems": 50, "minItems": 1, "items": {"$ref": "#/$defs/source"}}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["kind", "locator", "revision", "note"], "properties": {"kind": {"type": "string", "enum": ["conversation", "project_repository", "external", "file", "migration", "other"]}, "locator": {"type": "string", "minLength": 1, "maxLength": 1000}, "revision": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 200}, {"type": "null"}]}, "note": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 1000}, {"type": "null"}]}}},
    "relationship": {"type": "object", "additionalProperties": false, "required": ["type", "target_id", "note"], "properties": {"type": {"type": "string", "enum": ["related_to", "depends_on", "supersedes", "corrects", "conflicts_with"]}, "target_id": {"$ref": "#/$defs/uuid_v4"}, "note": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 1000}, {"type": "null"}]}}}
  }
}
